# User data and chat history
chat_history/
conversations/
user_data/
history/
/data/

# Local secrets and machine-specific config
.env
.env.*
!.env.example
!.env.*.example
*.key
config.local.json
*.log

# Runtime caches and temporary files
__pycache__/
runtime/temp/
dist/
installer/work/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*

# Keep bundled dependency source directories that are not user chat data.
!runtime/python/Lib/site-packages/openai/resources/conversations/
!runtime/python/Lib/site-packages/openai/resources/conversations/**
!runtime/python/Lib/site-packages/openai/types/conversations/
!runtime/python/Lib/site-packages/openai/types/conversations/**
